def background_autonomous_worker():
    """Continuously evaluates persistent tasks from SQLite and executes background operations with monetization tracking."""
    while True:
        conn = sqlite3.connect(DB_NAME)
        cursor = conn.cursor()
        cursor.execute("SELECT id, task_text FROM tasks WHERE status = 'QUEUED' LIMIT 1")
        row = cursor.fetchone()
        
        if row:
            task_id, task = row
            cursor.execute("UPDATE tasks SET status = 'RUNNING' WHERE id = ?", (task_id,))
            conn.commit()
            conn.close()
            
            print(f"Executing persistent autonomous task: {task}")
            payout_link = "https://www.paypal.me/CornellEugene"
            
            if "survey" in task.lower() or "offer" in task.lower():
                print(f"Targeting micro-task / offer completion pipeline. Revenue routing: {payout_link}")
            elif "diagnostic" in task.lower():
                print(f"Processing automated vehicle diagnostic dataset. Revenue routing: {payout_link}")
                
            conn = sqlite3.connect(DB_NAME)
            cursor = conn.cursor()
            cursor.execute("UPDATE tasks SET status = 'COMPLETED' WHERE id = ?", (task_id,))
            conn.commit()
        conn.close()
        time.sleep(5)
